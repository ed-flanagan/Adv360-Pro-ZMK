#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/stp.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/pointing.h>

#define DFLT 0
#define KP   1
#define FN   2
#define MOD  3

/ {
    behaviors {
      #include "macros.dtsi"
      #include "version.dtsi"

      hm: homerow_mods {
          compatible = "zmk,behavior-hold-tap";
          label = "HOMEROW_MODS";
          #binding-cells = <2>;
          tapping-term-ms = <200>;
          quick_tap_ms = <175>;
          flavor = "tap-preferred";
          bindings = <&kp>, <&kp>;
      };
    };

  keymap {
    compatible = "zmk,keymap";

    default_layer {
      display-name = "base";

      // Changes from Kinesis upstream:
      //
      // * Replace: CAPS  -> DEL
      // * Swap:    KP   <-> MOD
      // * Replace: DEL   -> LGUI
      // * Assign:  BLK3  -> C_PP
      // * Assign:  BLK4  -> C_NEXT
      // * Swap:    ^    <-> [
      // * Swap:    v    <-> ]
      //
      // ┌───────┬─────┬─────┬─────┬─────┬─────┬───────┐          ┌──────┬──────┐   ┌──────┬──────┐         ┌──────┬─────┬─────┬─────┬─────┬─────┬───────┐
      // │ EQUAL │  1  │  2  │  3  │  4  │  5  │ <MOD> │          │ CTRL │ LALT │   │ RALT │ CTRL │         │ <KP> │  6  │  7  │  8  │  9  │  0  │   -   │
      // │  TAB  │  Q  │  W  │  E  │  R  │  T  │  nil  │   ┌──────┼──────┼──────│   ├──────┼──────┼─────┐   │  ||> │  Y  │  U  │  I  │  O  │  P  │   \   │
      // │  ESC  │  A  │  S  │  D  │  F  │  G  │  nil  │   │      │      │ HOME │   │ PGUP │      │     │   │  >>  │  H  │  J  │  K  │  L  │  ;  │   '   │
      // │ SHIFT │  Z  │  X  │  C  │  V  │  B  ├───────┘   │ BSPC │ LGUI ├──────┤   ├──────┤ ENTR │ SPC │   └──────┤  N  │  M  │  ,  │  .  │  /  │ SHIFT │
      // │  <FN> │  `  │ DEL │ <-  │ ->  ├─────┘           │      │      │  END │   │ PGDN │      │     │          └─────┤  [  │  ]  │  ^  │  v  │ <FN>  │
      // └───────┴─────┴─────┴─────┴─────┘                 └──────┴──────┴──────┘   └──────┴──────┴─────┘                └─────┴─────┴─────┴─────┴───────┘

      bindings = <
        &kp EQUAL &kp N1    &kp N2  &kp N3   &kp N4     &kp N5 &mo MOD                                                           &tog KP    &kp N6 &kp N7   &kp N8    &kp N9  &kp N0   &kp MINUS
        &kp TAB   &kp Q     &kp W   &kp E    &kp R      &kp T  &none                                                             &kp C_PP   &kp Y  &kp U    &kp I     &kp O   &kp P    &kp BSLH
        &kp ESC   &kp A     &kp S   &kp D    &kp F      &kp G  &none            &kp LCTRL &kp LALT &kp RALT  &kp RCTRL           &kp C_NEXT &kp H  &kp J    &kp K     &kp L   &kp SEMI &kp SQT
        &kp LSHFT &kp Z     &kp X   &kp C    &kp V      &kp B                             &kp HOME &kp PG_UP                                &kp N  &kp M    &kp COMMA &kp DOT &kp FSLH &kp RSHFT
        &mo FN    &kp GRAVE &kp DEL &kp LEFT &kp RIGHT                 &kp BSPC &kp LGUI  &kp END  &kp PG_DN &kp ENTER &kp SPACE                   &kp LBKT &kp RBKT  &kp UP  &kp DOWN &mo FN
      >;
    };

    kp {
      display-name = "keypad";

      // Changes from Kinesis upstream:
      //
      // * Changed most bindings into `&trans`
      // * Move: KP_DOT to left-most-key-on-bottom-row-right-group
      // * Move: TOG 1 to left-most-key-on-top-row-right-group
      // * Replace: ENTER    -> KP_ENTER
      // * Replace: KP_EQUAL -> EQUAL (OS compatibility reasons)
      // * Remove:  both function buttons (mo 2)
      //
      // NOTE: I hard-code the toggle key as to ensure I won't lock myself out on layer

      bindings = <
        &trans &trans &trans &trans &trans &trans &trans                                                    &tog KP &trans &kp KP_NUM &kp EQUAL &kp KP_DIVIDE &kp KP_MULTIPLY &trans
        &trans &trans &trans &trans &trans &trans &trans                                                    &trans  &trans &kp KP_N7  &kp KP_N8 &kp KP_N9     &kp KP_MINUS    &trans
        &trans &trans &trans &trans &trans &trans &trans        &trans &trans &trans &trans                 &trans  &trans &kp KP_N4  &kp KP_N5 &kp KP_N6     &kp KP_PLUS     &trans
        &trans &trans &trans &trans &trans &trans                      &trans &trans                                &trans &kp KP_N1  &kp KP_N2 &kp KP_N3     &kp KP_ENTER    &kp RSHIFT
        &trans &trans &trans &trans &trans               &trans &trans &trans &trans &kp KP_ENTER &kp KP_N0                &kp KP_DOT &trans    &trans        &trans          &trans
      >;
    };

    fn {
      display-name = "function";

      // Changes from Kinesis upstream:
      //
      // * Changed all other bindings to `&trans`
      // * Added: Caps lock where the actual key is

      bindings = <
        &kp F1 &kp F2 &kp F3   &kp F4 &kp F5 &kp F6 &trans                                           &trans &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12
        &trans &trans &trans   &trans &trans &trans &trans                                           &trans &trans &trans &trans &trans  &trans  &trans
        &trans &trans &trans   &trans &trans &trans &trans        &trans &trans &trans &trans        &trans &trans &trans &trans &trans  &trans  &trans
        &trans &trans &trans   &trans &trans &trans                      &trans &trans                      &trans &trans &trans &trans  &trans  &trans
        &trans &trans &kp CAPS &trans &trans               &trans &trans &trans &trans &trans &trans               &trans &trans &trans  &trans  &trans
      >;
    };

    mod {
      display-name = "modifiers";

      // Changes from Kinesis upstream:
      //
      // * Move all actions to the left side of the keyboard - in the case left board doesn't correctly connect to right
      // * Change all other keys to `none`. Probably overkill - but want to ensure this layer overrides everything else

      bindings = <
        &none          &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &none                                                                   &none &none &none &none &none &none &none
        &none          &none        &none        &none        &none        &none        &bootloader                                                             &none &none &none &none &none &none &none
        &studio_unlock &none        &none        &none        &none        &none        &stp STP_BAT                 &bt BT_CLR &none          &none &none      &none &none &none &none &none &none &none
        &none          &none        &none        &none        &macro_ver   &none                                                &bl BL_INC     &none                  &none &none &none &none &none &none
        &none          &none        &none        &none        &none                                  &rgb_ug RGB_TOG &bl BL_TOG &bl BL_DEC     &none &none &none            &none &none &none &none &none
      >;
    };

    extra1 { 
      display-name = "Red";    
      status = "reserved";
    };

    extra2 { 
      display-name = "Purple";    
      status = "reserved";
    };

    extra3 { 
      display-name = "Cyan";    
      status = "reserved";
    };

    extra4 { 
      display-name = "Yellow";    
      status = "reserved";
    };
  };
};
